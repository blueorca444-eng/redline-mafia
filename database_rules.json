{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid))",
        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('phase').val() === 'lobby'"
          }
        },
        "votes": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('phase').val() === 'voting'"
          }
        }
      }
    },
    "privateRoles": {
      "$room": {
        ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "gameSecrets": {
      "$room": {
        ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() === auth.uid",
        "mafiaUid": {
          ".read": "auth != null && (root.child('rooms').child($room).child('hostUid').val() === auth.uid || root.child('rooms').child($room).child('phase').val() === 'results')"
        }
      }
    }
  }
}
